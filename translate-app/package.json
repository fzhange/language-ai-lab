{
  "name": "language-lab-translate",
  "productName": "Translate",
  "version": "0.1.0",
  "description": "Chinese-English desktop translation powered by Language AI Lab",
  "author": "Language AI Lab",
  "private": true,
  "main": "electron/main.bundle.cjs",
  "scripts": {
    "dev": "npm run build:native && npm run build:electron && node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5175 --strictPort",
    "build": "npm run build:native && npm run build:electron && tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "playwright test",
    "build:icon": "node scripts/icon.mjs",
    "build:native": "node scripts/native.mjs",
    "build:electron": "node scripts/electron.mjs",
    "package:mac": "npm run build && electron-builder --mac dir",
    "dist:mac": "npm run build && electron-builder --mac dmg"
  },
  "dependencies": {
    "@langchain/langgraph-sdk": "^1.12.0",
    "@radix-ui/react-tooltip": "^1.2.8",
    "koffi": "^3.3.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "dotenv": "^17.2.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "com.languageailab.translate",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/bin",
        "to": "selection-capture",
        "filter": [
          "selection-capture-*.dylib"
        ]
      }
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true
    }
  }
}
